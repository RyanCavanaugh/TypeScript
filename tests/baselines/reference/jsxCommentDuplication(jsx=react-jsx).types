=== jsxCommentDuplication.tsx ===
// Simple test case to reproduce JSX comment duplication
const x = 42;
>x : 42
>  : ^^
>42 : 42
>   : ^^

const jsx = <div>/*pre*/{x}/*post*/</div>;
>jsx : any
>    : ^^^
><div>/*pre*/{x}/*post*/</div> : any
>                              : ^^^
>div : any
>    : ^^^
>x : 42
>  : ^^
>div : any
>    : ^^^

